# lucide-react@0.263.1 (and a few other deps) declare peerDependencies capped at
# React 18 — a metadata gap, not a real incompatibility (this app runs fine on
# React 19 in practice). Without this, npm's strict ERESOLVE fails the install
# entirely on a fresh environment (e.g. Vercel's build).
legacy-peer-deps=true
